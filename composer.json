{
    "name": "glennbaquero/php-image-puzzle-captcha",
    "description": "Pure PHP puzzle captcha library that generates image-based puzzle challenges with X/Y validation. No JavaScript required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "captcha",
        "puzzle-captcha",
        "security",
        "php",
        "image",
        "anti-bot"
    ],
    "authors": [
        {
            "name": "Glenn Baquero",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-gd": "*",
        "ext-pdo": "*",
        "intervention/image": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "PuzzleCaptcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PuzzleCaptcha\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
